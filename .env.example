# ==============================================================================
# CineSphere — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in the values for local development:
#   cp .env.example .env
#
# NOTE: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser client.
# All other variables are strictly server-side and must never be exposed.
# Never commit actual credentials or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Configuration
# ------------------------------------------------------------------------------
# Runtime environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Backend NestJS API server port
PORT=4000

# Server-side API base URL (used by internal services / Docker)
API_URL=http://localhost:4000

# Frontend Next.js application URL
APP_URL=http://localhost:3000

# Client-side API URL (exposed to browser via Next.js NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Operating Mode:
# 'false' = Local full mode (live ML scripts, optional Ollama, personal tracking)
# 'true'  = Hosted portfolio mode (read-only demo, precomputed fixtures, Ollama disabled)
HOSTED_MODE=false
NEXT_PUBLIC_HOSTED_MODE=false

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16+ with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=cinesphere_user
POSTGRES_PASSWORD=cinesphere_dev_password
POSTGRES_DB=cinesphere
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Prisma & Application Database Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://cinesphere_user:cinesphere_dev_password@localhost:5432/cinesphere?schema=public

# ------------------------------------------------------------------------------
# 3. TMDB Metadata API (Required for Catalogue Features)
# ------------------------------------------------------------------------------
# TMDB API v3 Key (Obtain from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# TMDB API v4 Read Access Token (Bearer token, alternative to API Key)
TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here

# TMDB API Base URL
TMDB_BASE_URL=https://api.themoviedb.org/3

# ------------------------------------------------------------------------------
# 4. Optional Local LLM (Ollama)
# ------------------------------------------------------------------------------
# Enable or disable local Ollama integration (true | false).
# All core recommendation, tracking, and map features work without Ollama.
OLLAMA_ENABLED=false

# Ollama HTTP API endpoint (default local daemon URL)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama local model tag (e.g., llama3.2, mistral, phi3)
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 5. Machine Learning & Recommendation Parameters
# ------------------------------------------------------------------------------
# Sentence Transformers model identifier (Reference: TD-08)
# Options: 'all-MiniLM-L6-v2' (384-dim, fast) | 'all-mpnet-base-v2' (768-dim, high quality)
EMBEDDING_MODEL_ID=all-MiniLM-L6-v2

# Default recommendation diversity mode: 'safe' | 'balanced' | 'experimental'
RECOMMENDATION_DEFAULT_DIVERSITY_MODE=balanced

# ------------------------------------------------------------------------------
# 6. Security & Session (Local / Single-User Baseline — Reference: TD-10)
# ------------------------------------------------------------------------------
# Secret key used for session signing or internal token generation
SESSION_SECRET=cinesphere_local_development_session_secret_change_in_production

# Deterministic single-user UUID (Required RFC 4122 v4 UUID for Phase 3 tracking)
CINESPHERE_SINGLE_USER_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
