// ==============================================================================
// CineSphere — Prisma Schema
// ==============================================================================
// Phase 1: Foundation tables (User, SystemConfig)
// Phase 2A: Catalogue tables (Movie, TvShow, Season, Episode, Genre, Keyword,
//           Person, PersonCredit)
//
// ARCHITECTURE NOTES:
//   - Vector operations are isolated in VectorRepository using raw SQL.
//     No vector columns are defined here (pending TD-08: embedding model selection).
//   - PersonCredit uses a nullable movieId / tvShowId pair.
//     The database enforces exactly-one-of via a CHECK constraint in the migration.
//     Prisma cannot express this constraint natively; it is documented and preserved
//     in migration SQL.
//   - Genre and Keyword records are shared between Movie and TvShow via implicit
//     many-to-many join tables (Prisma generates _MovieToGenre, _TvShowToGenre,
//     _MovieToKeyword, _TvShowToKeyword automatically).
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Foundation ────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName String   @default("CineSphere User") @db.VarChar(100)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  libraryEntries UserLibraryEntry[]

  @@map("users")
}

model SystemConfig {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("system_configs")
}

// ── Catalogue: Genres & Keywords ──────────────────────────────────────────────

model Genre {
  tmdbId Int    @id
  name   String @db.VarChar(100)

  movies  Movie[]
  tvShows TvShow[]

  @@map("genres")
}

model Keyword {
  tmdbId Int    @id
  name   String @db.VarChar(255)

  movies  Movie[]
  tvShows TvShow[]

  @@map("keywords")
}

// ── Catalogue: Movie ──────────────────────────────────────────────────────────

model Movie {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tmdbId        Int       @unique
  title         String    @db.VarChar(500)
  originalTitle String?   @db.VarChar(500)
  overview      String?   @db.Text
  releaseDate   DateTime? @db.Date
  runtime       Int? // minutes
  originalLanguage String? @db.VarChar(10)
  popularity    Float?
  voteAverage   Float?
  voteCount     Int?
  posterPath    String?   @db.VarChar(255)
  backdropPath  String?   @db.VarChar(255)
  adult         Boolean   @default(false)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  syncedAt      DateTime? @db.Timestamptz(6)

  genres        Genre[]
  keywords      Keyword[]
  personCredits PersonCredit[]
  libraryEntries UserLibraryEntry[]

  @@index([popularity])
  @@map("movies")
}

// ── Catalogue: TV Show ────────────────────────────────────────────────────────

model TvShow {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tmdbId           Int       @unique
  name             String    @db.VarChar(500)
  originalName     String?   @db.VarChar(500)
  overview         String?   @db.Text
  firstAirDate     DateTime? @db.Date
  lastAirDate      DateTime? @db.Date
  originalLanguage String?   @db.VarChar(10)
  popularity       Float?
  voteAverage      Float?
  voteCount        Int?
  posterPath       String?   @db.VarChar(255)
  backdropPath     String?   @db.VarChar(255)
  status           String?   @db.VarChar(50)
  numberOfSeasons  Int?
  numberOfEpisodes Int?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  syncedAt         DateTime? @db.Timestamptz(6)

  genres        Genre[]
  keywords      Keyword[]
  seasons       Season[]
  personCredits PersonCredit[]
  libraryEntries UserLibraryEntry[]

  @@index([popularity])
  @@map("tv_shows")
}

// ── Catalogue: Season ─────────────────────────────────────────────────────────

model Season {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tmdbId       Int?      @unique // TMDB season IDs can be absent for special seasons, unique when present
  seasonNumber Int
  name         String?   @db.VarChar(255)
  overview     String?   @db.Text
  posterPath   String?   @db.VarChar(255)
  airDate      DateTime? @db.Date

  tvShowId String @db.Uuid
  tvShow   TvShow @relation(fields: [tvShowId], references: [id], onDelete: Cascade)

  episodes Episode[]
  seasonRatings SeasonRating[]

  // A season number must be unique within a TV show (supports season 0 / specials)
  @@unique([tvShowId, seasonNumber])
  @@index([tvShowId])
  @@map("seasons")
}

// ── Catalogue: Episode ────────────────────────────────────────────────────────

model Episode {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tmdbId        Int?      @unique // TMDB episode IDs can be absent, unique when present
  episodeNumber Int
  name          String?   @db.VarChar(255)
  overview      String?   @db.Text
  airDate       DateTime? @db.Date
  runtime       Int? // minutes

  seasonId String @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  episodeProgresses EpisodeProgress[]

  // Episode number must be unique within a season
  @@unique([seasonId, episodeNumber])
  @@index([seasonId])
  @@map("episodes")
}

// ── Catalogue: People ─────────────────────────────────────────────────────────

model Person {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tmdbId    Int      @unique
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  personCredits PersonCredit[]

  @@map("persons")
}

// ── Catalogue: PersonCredit ───────────────────────────────────────────────────
//
// A single combined table for movie AND TV show cast appearances.
//
// CONSTRAINT: Exactly one of movieId or tvShowId must be non-null.
//   This is enforced by a PostgreSQL CHECK constraint in the migration:
//     CHECK (
//       (movie_id IS NOT NULL AND tv_show_id IS NULL) OR
//       (movie_id IS NULL AND tv_show_id IS NOT NULL)
//     )
//   Prisma cannot express this directly; it is documented here and present in
//   the migration SQL.
//
// UNIQUENESS: A person may appear only once per movie and once per TV show.
//   Enforced by unique constraints on (person_id, movie_id) and
//   (person_id, tv_show_id) respectively (with NULLs excluded via partial index).
//
model PersonCredit {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId  String  @db.Uuid
  movieId   String? @db.Uuid
  tvShowId  String? @db.Uuid

  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  movie   Movie?  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  tvShow  TvShow? @relation(fields: [tvShowId], references: [id], onDelete: Cascade)

  // Index for "all credits belonging to a person"
  @@index([personId])
  @@map("person_credits")
}

// ── Phase 3: Enums ────────────────────────────────────────────────────────────

enum MediaType {
  MOVIE
  TV
}

enum LibraryStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
  DROPPED
}

// ── Phase 3: Personal Library Models ──────────────────────────────────────────

model UserLibraryEntry {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  userId         String        @db.Uuid @map("user_id")
  mediaType      MediaType     @map("media_type")
  movieId        String?       @db.Uuid @map("movie_id")
  tvShowId       String?       @db.Uuid @map("tv_show_id")
  status         LibraryStatus @map("status")
  personalRating Decimal?      @db.Decimal(4, 2) @map("personal_rating")
  notes          String?       @db.Text @map("notes")
  createdAt      DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie  Movie?  @relation(fields: [movieId], references: [id], onDelete: Restrict)
  tvShow TvShow? @relation(fields: [tvShowId], references: [id], onDelete: Restrict)

  viewingEvents     ViewingEvent[]
  episodeProgresses EpisodeProgress[]
  seasonRatings     SeasonRating[]

  @@map("user_library_entries")
}

model ViewingEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  libraryEntryId String    @db.Uuid @map("library_entry_id")
  watchedAt      DateTime  @default(now()) @db.Timestamptz(6) @map("watched_at")
  rating         Decimal?  @db.Decimal(4, 2) @map("rating")
  notes          String?   @db.Text @map("notes")

  libraryEntry UserLibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)

  @@map("viewing_events")
}

model EpisodeProgress {
  libraryEntryId String   @db.Uuid @map("library_entry_id")
  episodeId      String   @db.Uuid @map("episode_id")
  watchedAt      DateTime @default(now()) @db.Timestamptz(6) @map("watched_at")

  libraryEntry UserLibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  episode      Episode          @relation(fields: [episodeId], references: [id], onDelete: Restrict)

  @@id([libraryEntryId, episodeId])
  @@map("episode_progress")
}

model SeasonRating {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  libraryEntryId String   @db.Uuid @map("library_entry_id")
  seasonId       String   @db.Uuid @map("season_id")
  rating         Decimal  @db.Decimal(4, 2) @map("rating")
  createdAt      DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  libraryEntry UserLibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  season       Season           @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  @@unique([libraryEntryId, seasonId])
  @@map("season_ratings")
}

