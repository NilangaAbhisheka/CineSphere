# ==============================================================================
# CineSphere — Git Attributes
# Ensure consistent line endings across operating systems (LF normalized)
# ==============================================================================

# Default line endings for all text files
* text=auto eol=lf

# Explicit text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.mdc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.env.example text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Windows specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.tar.gz binary
*.zip binary
